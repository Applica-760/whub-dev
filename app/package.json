{
  "name": "whub-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "generate:types": "uv run --project .. python -m whub.webapp.openapi > openapi.json && openapi-typescript openapi.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@tabler/icons-react": "^3.44.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.0.0",
    "remark-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.0.0",
    "postcss-preset-mantine": "^1.0.0",
    "postcss-simple-vars": "^7.0.0",
    "prettier": "3.9.5",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
